{
  groups: {
    gameplay: {
      title: "Gameplay",
      description: "Fixture group.",
      save: true,
      synchronize: true,
    },
  },
  types: {
    bad_mask: {
      kind: "mask",
      base_type: "uint8",
      values: { all: 7 },
      flags: { first: 1, invalid: 3 },
    },
  },
  records: {},
  parameters: {
    value: {
      title: "Value",
      description: "Invalid mask fixture.",
      group: "gameplay",
      type: "bad_mask",
      default: "all",
      bind_root: { header: "fixture.h", symbol: "fixture" },
      bind: ["value"],
    },
  },
}