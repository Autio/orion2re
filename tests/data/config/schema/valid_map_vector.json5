{
  groups: {
    gameplay: {
      title: "Gameplay",
      description: "Deterministic gameplay settings.",
      save: true,
      synchronize: true,
    },
  },
  types: {
    keyed_entry: {
      internal: true,
      kind: "enum",
      base_type: "uint8",
      values: { first: 0, second: 1 },
    },
  },
  records: {
    pair: {
      internal: true,
      fields: [
        { id: "foo", type: "uint8", bind: ["foo"] },
        { id: "bar", type: "uint8", bind: ["bar"] },
      ],
    },
  },
  parameters: {
    keyed: {
      title: "Keyed values",
      description: "A fixed semantic map.",
      group: "gameplay",
      namespace: "settings",
      bind_root: { header: "fixture.h", symbol: "fixture::keyed" },
      type: {
        kind: "map",
        count: 2,
        index_base: 0,
        index_type: "keyed_entry",
        fill: { foo: 1, bar: 2 },
        element: { type: "pair" },
      },
    },
    dynamic: {
      title: "Dynamic values",
      description: "A zero-based dynamically sized sequence.",
      group: "gameplay",
      namespace: "settings",
      bind_root: { header: "fixture.h", symbol: "fixture::dynamic" },
      type: {
        kind: "vector",
        count: 1,
        fill: { foo: 0, bar: 0 },
        element: { type: "pair" },
      },
      default: [
        { foo: 3, bar: 4 },
      ],
    },
  },
}