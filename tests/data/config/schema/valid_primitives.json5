{
  groups: {
    interface: {
      title: "Interface",
      description: "Local settings.",
      save: false,
      synchronize: false,
    },
  },
  types: {},
  records: {},
  parameters: {
    enabled: {
      title: "Enabled",
      description: "Boolean fixture.",
      group: "interface",
      type: "bool",
      default: true,
      bind_root: { header: "fixture.h", symbol: "fixture" },
      bind: ["enabled"],
    },
    signed_value: {
      title: "Signed value",
      description: "Constrained integer fixture.",
      group: "interface",
      type: "int8",
      constraints: { min: -0x0A, max: 0x0A },
      default: -0x02,
      bind_root: { header: "fixture.h", symbol: "fixture" },
      bind: ["signed_value"],
    },
    captain_name: {
      title: "Captain name",
      description: "CP850 string fixture.",
      group: "interface",
      type: "string",
      constraints: { min_length: 1, max_length: 8, encoding: "cp850" },
      default: "Grüße",
      bind_root: { header: "fixture.h", symbol: "fixture" },
      bind: ["captain_name"],
    },
  },
}