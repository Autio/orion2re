{
  groups: {
    gameplay: {
      title: "Gameplay",
      description: "Fixture group.",
      save: true,
      synchronize: true,
    },
  },
  types: {},
  records: {},
  parameters: {
    ships: {
      title: "Ships",
      description: "Top-level parameter conflicting with a namespace.",
      group: "gameplay",
      type: "uint8",
      default: 0,
      bind_root: { header: "fixture.h", symbol: "fixture" },
      bind: ["ships"],
    },
    guardian: {
      title: "Guardian",
      description: "Namespaced parameter fixture.",
      group: "gameplay",
      namespace: "ships",
      type: "uint8",
      default: 0,
      bind_root: { header: "fixture.h", symbol: "fixture" },
      bind: ["guardian"],
    },
  },
}